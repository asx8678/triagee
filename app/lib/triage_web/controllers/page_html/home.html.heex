<Layouts.app flash={@flash} active_page="home">
  <div id="home-overview" class="stack ov-dashboard">
    <%!-- Posture only: no page header, and every workflow link lives in the
         persistent top navigation. The heading stays in the document for
         assistive technology, not as drawn chrome. --%>
    <h1 id="home-title" class="sr-only">Overview</h1>

    <section id="home-inventory" class="stack" aria-labelledby="home-inventory-title">
      <h2 id="home-inventory-title" class="sr-only">Local inventory</h2>

      <%= case @summary do %>
        <% {:ok, s} -> %>
          <%!-- Assistive technology only: a count of distinct CVEs is not a clean estate. --%>
          <p id="home-inventory-intro" class="sr-only">
            Each count is one distinct CVE, not an image occurrence. Suppressed and no-longer-observed
            advisories are excluded; zero is not a clean estate. A CVE recorded at more than one
            severity appears in each of those severity counts, so the bands can add up to more than
            the total, which counts distinct CVEs.
          </p>

          <div class="ov-band">
            <dl id="home-summary" class="ov-kpis">
              <div class="ov-kpi ov-kpi-critical">
                <dt>Critical</dt>
                <dd id="home-critical-count">
                  <.link href={~p"/findings?severity=CRITICAL"}>{s.critical}</.link>
                </dd>
              </div>
              <div class="ov-kpi ov-kpi-high">
                <dt>High</dt>
                <dd id="home-high-count">
                  <.link href={~p"/findings?severity=HIGH"}>{s.high}</.link>
                </dd>
              </div>
              <div class="ov-kpi ov-kpi-medium">
                <dt>Medium</dt>
                <dd id="home-medium-count">
                  <.link href={~p"/findings?severity=MEDIUM"}>{s.medium}</.link>
                </dd>
              </div>
              <div class="ov-kpi ov-kpi-low">
                <dt>Low</dt>
                <dd id="home-low-count">
                  <.link href={~p"/findings?severity=LOW"}>{s.low}</.link>
                </dd>
              </div>
              <div class="ov-kpi ov-kpi-total">
                <dt>Total</dt>
                <dd id="home-total-count">{s.total}</dd>
              </div>
            </dl>

            <div class="ov-sevbar-wrap">
              <span
                class="ov-sevbar"
                role="img"
                aria-label={"Severity mix of #{s.total} distinct CVEs: #{s.critical} critical, #{s.high} high, #{s.medium} medium, #{s.low} low. A CVE recorded at more than one severity appears in each band."}
              >
                <span class="ov-sevbar-seg ov-sevbar-critical" style={"flex: #{s.critical} 1 0"}></span>
                <span class="ov-sevbar-seg ov-sevbar-high" style={"flex: #{s.high} 1 0"}></span>
                <span class="ov-sevbar-seg ov-sevbar-medium" style={"flex: #{s.medium} 1 0"}></span>
                <span class="ov-sevbar-seg ov-sevbar-low" style={"flex: #{s.low} 1 0"}></span>
              </span>
              <p class="supporting">
                Severity mix · {s.total} distinct CVEs · a CVE recorded at more than one severity
                appears in each band
              </p>
            </div>
          </div>
        <% _ -> %>
          <.notice id="home-summary-error" kind="warning" title="Inventory counts unavailable">
            Could not load inventory counts.
            <.link href={~p"/findings"}>Retry via findings</.link>
          </.notice>
      <% end %>

      <div class="ov-secondary">
        <h2 id="overview-inventory-title" class="ov-secondary-title">Occurrence counts</h2>
        <%= case @occurrence_counts do %>
          <% {:ok, counts} -> %>
            <dl id="overview-counts" class="ov-inline-stats">
              <div>
                <dt>Open occurrences</dt>
                <dd id="open-occurrence-count">
                  <.link id="overview-open-link" href={~p"/findings"}>{counts.open}</.link>
                </dd>
              </div>
              <div>
                <dt>Suppressed occurrences</dt>
                <dd id="suppressed-occurrence-count">
                  <.link id="overview-suppressed-link" href={~p"/findings?suppressed=1"}>
                    {counts.suppressed}
                  </.link>
                </dd>
              </div>
            </dl>
            <p class="supporting">
              Occurrences, not distinct CVEs · suppression is not mitigation.
            </p>
          <% _ -> %>
            <.notice
              id="overview-counts-unavailable"
              kind="warning"
              title="Occurrence counts unavailable"
            >
              Counts could not be loaded. <.link href={~p"/"}>Retry Overview</.link>
            </.notice>
        <% end %>
      </div>

      <div class="ov-grid">
        <section id="home-active" class="ov-col" aria-labelledby="home-active-title">
          <div class="section-header">
            <h3 id="home-active-title">Active now</h3>
            <span class="supporting">Most recently observed first</span>
          </div>
          <%= case @active_now do %>
            <% {:ok, []} -> %>
              <.empty_state
                id="home-active-empty"
                title="No active advisories recorded"
                description="No open, unsuppressed advisory with an active placement is recorded locally. An empty rail is not proof of a clean estate."
              >
                <:actions><.link href={~p"/findings"}>Browse findings</.link></:actions>
              </.empty_state>
            <% {:ok, rows} -> %>
              <ul id="home-active-list" class="ov-list">
                <li
                  :for={row <- rows}
                  id={"home-active-#{row.cve}"}
                  class="ov-list-row"
                >
                  <div class="ov-list-main">
                    <h4 class="ov-list-title">
                      <.link href={~p"/cves/#{row.cve}"}>{row.cve}</.link>
                    </h4>
                    <p class="supporting">
                      {display_value(row.team_list, "No team named")} · {if row.images == 1,
                        do: "#{row.images} image",
                        else: "#{row.images} images"} ·
                      last observed <.timestamp value={row.last_seen} />
                    </p>
                  </div>
                  <.status_badge label={row.severity} kind="severity" />
                </li>
              </ul>
              <p id="home-active-caption" class="supporting cluster">
                {rail_caption(@advisory_total, rows)} by most recent local observation ·
                <.link id="home-active-all" href={~p"/findings?sort=last_seen"}>
                  See all findings in this order
                </.link>
              </p>
            <% _ -> %>
              <.notice id="home-active-error" kind="warning" title="Active rail unavailable">
                Could not load inventory.
                <.link href={~p"/findings"}>Browse findings directly</.link>
              </.notice>
          <% end %>
        </section>

        <section id="home-newest" class="ov-col" aria-labelledby="home-newest-title">
          <div class="section-header">
            <h3 id="home-newest-title">Newest discovered</h3>
            <span class="supporting">First observed locally first</span>
          </div>
          <%= case @newest do %>
            <% {:ok, []} -> %>
              <.empty_state
                id="home-newest-empty"
                title="No open advisories recorded"
                description="The inventory is empty. An empty overview is not proof of a clean estate."
              >
                <:actions><.link href={~p"/findings"}>Browse findings</.link></:actions>
              </.empty_state>
            <% {:ok, rows} -> %>
              <ul id="home-newest-list" class="ov-list">
                <li
                  :for={row <- rows}
                  id={"home-newest-#{row.cve}"}
                  class="ov-list-row"
                >
                  <div class="ov-list-main">
                    <h4 class="ov-list-title">
                      <.link href={~p"/cves/#{row.cve}"}>{row.cve}</.link>
                    </h4>
                    <p class="supporting">
                      {display_value(row.team_list, "No team named")} · {if row.images == 1,
                        do: "#{row.images} image",
                        else: "#{row.images} images"} ·
                      first observed <.timestamp value={row.first_seen} />
                    </p>
                  </div>
                  <.status_badge label={row.severity} kind="severity" />
                </li>
              </ul>
              <p id="home-newest-caption" class="supporting cluster">
                {rail_caption(@advisory_total, rows)} by first local observation ·
                <.link id="home-newest-all" href={~p"/findings?sort=newest"}>See all findings</.link>
              </p>
            <% _ -> %>
              <.notice id="home-newest-error" kind="warning" title="Newest rail unavailable">
                Could not load inventory.
                <.link href={~p"/findings"}>Browse findings directly</.link>
              </.notice>
          <% end %>
        </section>
      </div>

      <p id="home-scope-note" class="supporting">
        Both rails read the same active inventory as every other view: unresolved, unsuppressed and
        with an active placement. Scanner severity is not impact. The critical work list lives in <.link href={
          ~p"/triage"
        }>Triage</.link>, the complete searchable inventory in <.link href={~p"/findings"}>Findings</.link>, and cached public intelligence in <.link href={
          ~p"/intel"
        }>Intel</.link>.
      </p>
    </section>
  </div>
</Layouts.app>
