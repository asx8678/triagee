<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Overview" suffix=" · Triage" phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- Workspace styles only; the comfort layer refines the same scoped UI. --%>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/tailwind.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/workspace.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/workspace-comfort.css"} />
    <%!-- Same-origin Phoenix client distributions, generated from the
           mix.lock-pinned deps by `mix assets.setup` (see README.md "Assets").
           Deferred scripts execute in document order: phoenix.js defines the
           `Phoenix` global and phoenix_live_view.js the `LiveView` global, then
           js/app.js boots the LiveSocket. --%>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/vendor/phoenix.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/vendor/phoenix_html.js"}>
    </script>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/vendor/phoenix_live_view.js"}
    >
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
