[Unit]
Description=Triage Phoenix application
After=network.target postgresql.service

[Service]
Type=simple
User=triage
Group=triage
WorkingDirectory=/opt/triage/current
EnvironmentFile=/etc/triage/triage.env
Environment=RELEASE_DISTRIBUTION=none
Environment=RELEASE_TMP=/run/triage
RuntimeDirectory=triage
RuntimeDirectoryMode=0700
ExecStart=/opt/triage/current/bin/triage start
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
