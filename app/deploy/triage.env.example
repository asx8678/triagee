# Copy outside the repository to /etc/triage/triage.env, mode 0600.
# Replace placeholders. Never commit the populated file.
PHX_SERVER=true
PHX_HOST=triage.example.com
PORT=4000
TRIAGE_BIND=127.0.0.1
DATABASE_URL=ecto://triage:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1/triage
SECRET_KEY_BASE=REPLACE_WITH_OUTPUT_OF_mix_phx.gen.secret
POOL_SIZE=10
# Keep ADO_* credentials absent until an approved live integration test.
