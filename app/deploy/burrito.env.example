# Copy outside the checkout, chmod 600, then edit. Never distribute real secrets.
# PostgreSQL must already exist. URL-encode special characters in its password.
DATABASE_URL='ecto://triage:CHANGE_ME@127.0.0.1:5432/triage'
# Generate with ./triage secret. Keep the same value across restarts/upgrades.
SECRET_KEY_BASE='REPLACE_WITH_GENERATED_SECRET'
PHX_HOST='localhost'
TRIAGE_BIND='127.0.0.1'
PORT='4000'
# Production authentication remains mandatory. No default account or demo data.
TRIAGE_DEMO_MODE='false'
TRIAGE_ANALYSIS_ENABLED='false'
